---
import '../styles/global.css';
import '../styles/concept-motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  withBrand?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  schema?: object[];
  publishedTime?: string;
  modifiedTime?: string;
}
const {
  title,
  description,
  withBrand = true,
  ogType = 'website',
  ogImage = SITE.ogImage,
  noindex = false,
  schema = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = withBrand && !title.includes(SITE.name) ? `${title} — ${SITE.name}` : title;
const is404 = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/concepts/fonts/xn7gYHE41ni1AdIRggOxSuXd.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/concepts/fonts/Yq6W-LOTXCb04q32xlpwv8ZfrxE.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/concepts/fonts.css" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#070b16" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!is404 && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <canvas id="stars" aria-hidden="true"></canvas>
    <div class="cosmos">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline src="/concepts/stars.js"></script>
    <script is:inline src="/concepts/motion.js"></script>
  </body>
</html>
