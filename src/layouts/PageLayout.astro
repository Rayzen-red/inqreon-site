---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const { title, description, h1, noindex = false } = Astro.props;
const en = Astro.url.pathname.startsWith('/en/');
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="container page-hero">
    <Breadcrumbs items={[{ name: en ? 'Home' : 'Главная', href: en ? '/en/' : '/' }, { name: h1 ?? title }]} />
    <p class="kicker">Inqreon</p>
    <h1>{h1 ?? title}</h1>
  </div>
  <div class="container narrow">
    <div class="prose glass-panel">
      <slot />
    </div>
  </div>
</BaseLayout>
