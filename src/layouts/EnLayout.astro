---
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/en.css';
import '../styles/portal.css';
import '../styles/rescue.css';
import '../styles/services-theme.css';
import Analytics from '../components/Analytics.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE } from '../data/site';
import { PAGE } from '../data/offer';
import { SERVICE_PATH } from '../data/automation';

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  lang?: 'en' | 'ru';
  /** Site path for canonical and og:url. Defaults to the English service page. */
  path?: string;
  /** Replaces the service-page hreflang pair. The privacy page uses this. */
  alternates?: { en: string; ru: string; xDefault: string };
}
const { title = PAGE.title, description = PAGE.description, schema = [], lang = 'en', path = '/en/services/', alternates } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const enHref = alternates?.en ?? new URL(SERVICE_PATH.en, SITE.url).href;
const ruHref = alternates?.ru ?? new URL(SERVICE_PATH.ru, SITE.url).href;
const xDefault = alternates?.xDefault ?? enHref;
const ogImage = new URL('/images/en/og-share-1200x630.webp', SITE.url).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ru" href={ruHref} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/concepts/fonts/xn7gYHE41ni1AdIRggOxSuXd.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/concepts/fonts/Yq6W-LOTXCb04q32xlpwv8ZfrxE.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/concepts/fonts.css" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A dark glass app panel with a lime edge light, on a black grid." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reduce-motion');
      }
    </script>
    <Analytics />
  </head>
  <body class="svc-page">
    <a class="skip" href="#main">{lang === 'ru' ? 'К содержанию' : 'Skip to content'}</a>
    <slot />
    <CookieBanner />
  </body>
</html>
