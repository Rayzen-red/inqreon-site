---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { RUBRICS } from '../data/rubrics';
import RubricIcon from '../components/concepts/RubricIcon.astro';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const filled = new Set(articles.map((a) => a.data.rubric));
const nav = RUBRICS.filter((r) => r.inNav && filled.has(r.slug));
---
<BaseLayout title="Страница не найдена" description="Такой страницы нет. Перейдите на главную или в одну из рубрик Inqreon." noindex={true}>
  <div class="container page-hero">
    <p class="kicker">404</p>
    <h1>Страница не найдена</h1>
    <p class="lead">Возможно, материал ещё готовится или адрес набран с ошибкой.</p>
    <p><a class="btn" href="/">На главную</a></p>
  </div>
  <nav class="rubric-nav" aria-label="Рубрики">
    {nav.map((r) => (
      <a href={`/${r.slug}/`}>
        <RubricIcon slug={r.slug} />
        <span>{r.name}</span>
      </a>
    ))}
  </nav>
</BaseLayout>
