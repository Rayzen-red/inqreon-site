---
import ConceptShell from '../layouts/ConceptShell.astro';
import ConceptSwitch from '../components/concepts/ConceptSwitch.astro';
import ConceptFooter from '../components/concepts/ConceptFooter.astro';
import RubricIcon from '../components/concepts/RubricIcon.astro';
import PartnerDisclosure from '../components/PartnerDisclosure.astro';
import { HERO, TOOLS, loadConceptHome } from '../lib/concept-home';
import '../styles/concept-motion.css';
import '../styles/concept-c.css';

const { articles, rubrics, space, site } = await loadConceptHome();
---
<ConceptShell title="Концепт C — продуктовый стиль — Inqreon" description="Черновик главной: мягкий продуктовый стиль Inqreon.">
  <div class="play">
    <header class="top">
      <a class="logo" href="/"><span aria-hidden="true">✦</span> Inqreon</a>
      <ConceptSwitch current="c" />
      <a class="pill" href={site.telegram} target="_blank" rel="noopener">t.me/Inqreon</a>
    </header>
    <p class="hello">{site.tagline}</p>

    <nav class="rubric-nav" aria-label="Рубрики" data-reveal>
      {rubrics.map((r) => (
        <a href={`/${r.slug}/`}>
          <RubricIcon slug={r.slug} />
          <span>{r.name}</span>
        </a>
      ))}
    </nav>

    <section class="bento">
      <div class="tile slider-tile" data-slider aria-roledescription="карусель" aria-label="Избранные материалы">
        <div class="hero-frame">
          {articles.map((article, i) => {
            const photo = HERO[i % HERO.length];
            return (
            <article class:list={['slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
              <img src={photo.src} alt={photo.alt} />
              <div class="slide-copy">
                <p class="eyebrow">{article.rubricName} · проверено {article.dateLabel}</p>
                <h1><a href={article.href}>{article.title}</a></h1>
                <p>{article.description}</p>
                <p class="shot-note">{photo.note}</p>
                <a class="pill solid" href={article.href}>Читать</a>
              </div>
            </article>
            );
          })}
        </div>
        <div class="hero-ui">
          <button type="button" data-prev aria-label="Предыдущий материал">←</button>
          <div class="dots">
            {articles.map((_, i) => (
              <button type="button" data-dot class:list={[{ 'is-active': i === 0 }]} aria-label={`Слайд ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'}></button>
            ))}
          </div>
          <button type="button" data-next aria-label="Следующий материал">→</button>
        </div>
      </div>

      <a class="tile tg-tile" href={site.telegram} target="_blank" rel="noopener" data-reveal>
        <p class="eyebrow">Канал</p>
        <h2>Загляните в Telegram</h2>
        <p>Короткие разборы и обновления обзоров — t.me/Inqreon.</p>
        <span class="pill light">Открыть канал</span>
      </a>

      {space && (
        <a class="tile space-tile" href={`/${space.slug}/`} data-reveal>
          <img src={HERO[2].src} alt={HERO[2].alt} />
          <div>
            <p class="eyebrow"><RubricIcon slug={space.slug} /> {space.name}</p>
            <h2>{space.name}</h2>
            <p>{space.description}</p>
            <p class="shot-note">{HERO[2].note}</p>
          </div>
        </a>
      )}
    </section>

    <section class="tools" data-reveal>
      <header>
        <h2>Карточки инструментов</h2>
        <p>Цветные монограммы вместо логотипов. Нажатие открывает обзор.</p>
      </header>
      <PartnerDisclosure />
      <div class="tool-grid">
        {TOOLS.map((tool) => (
          <a class={`tool tone-${tool.tone}`} href={tool.href}>
            <span class="mark" aria-hidden="true">{tool.mark}</span>
            <strong>{tool.name}</strong>
            <em>{tool.text}</em>
            <small>заглушка логотипа</small>
          </a>
        ))}
      </div>
    </section>

    <section class="stories" data-reveal>
      <h2>Материалы</h2>
      <div class="cards">
        {articles.map((article) => (
          <a class="story" href={article.href}>
            <img src={article.cover.src} alt={article.cover.alt} />
            <div>
              <p class="eyebrow">{article.rubricName}</p>
              <h3>{article.title}</h3>
              <p>{article.description}</p>
              <p class="shot-note">{article.cover.note}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="rubric-cloud" data-reveal>
      <h2>Куда идти дальше</h2>
      <div class="cloud">
        {rubrics.map((r) => (
          <a href={`/${r.slug}/`}>
            <RubricIcon slug={r.slug} />
            <span>
              <strong>{r.name}</strong>
              <em>{r.description}</em>
            </span>
          </a>
        ))}
      </div>
    </section>

    <ConceptFooter />
  </div>
</ConceptShell>
