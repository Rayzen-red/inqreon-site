---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RubricIcon from '../../components/concepts/RubricIcon.astro';
import PartnerDisclosure from '../../components/PartnerDisclosure.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import SyntxAffiliate from '../../components/SyntxAffiliate.astro';
import CompareTable from '../../components/portal/CompareTable.astro';
import GuideNotes from '../../components/portal/GuideNotes.astro';
import { RUBRICS } from '../../data/rubrics';
import { SITE } from '../../data/site';
import { SPACE_IMAGES } from '../../lib/media';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return RUBRICS.map((rubric) => ({
    params: { rubric: rubric.slug },
    props: {
      rubric,
      items: articles
        .filter((a) => a.data.rubric === rubric.slug)
        .sort((a, b) => +(b.data.updatedAt ?? b.data.checkedAt) - +(a.data.updatedAt ?? a.data.checkedAt)),
    },
  }));
}
const { rubric, items } = Astro.props;
const isCatalog = rubric.slug === 'instrumenty';
const isCompare = rubric.slug === 'sravneniya';
const isSpace = rubric.slug === 'kosmos-i-nauka';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: rubric.name, item: `${SITE.url}/${rubric.slug}/` },
  ],
}];
---
<BaseLayout title={isCatalog ? 'Гид по инструментам' : isCompare ? 'Сравнение агрегаторов нейросетей' : rubric.name} description={isCatalog ? 'Обзоры ChatGPT, Claude, Gemini и других инструментов: для чего каждый, где он слабее и какие цены сверены.' : isCompare ? 'Сервисы, которые собирают много моделей в одном чате или в одном API. Без оценок. Цены и проверка по странам — в статье.' : rubric.description} noindex={items.length === 0 && !isCatalog && !isCompare} schema={schema}>
  {isSpace ? (
    <header class="page-banner container">
      <img src={SPACE_IMAGES[0].src} alt={SPACE_IMAGES[0].alt} width={SPACE_IMAGES[0].width} height={SPACE_IMAGES[0].height} fetchpriority="high" decoding="async" />
      <div class="page-banner-copy">
        <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: rubric.name }]} />
        <p class="kicker"><RubricIcon slug={rubric.slug} /> Рубрика</p>
        <h1>{rubric.name}</h1>
        <p class="lead">{rubric.description}</p>
      </div>
    </header>
  ) : (
    <div class="container page-hero">
      <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: rubric.name }]} />
      <p class="kicker"><RubricIcon slug={rubric.slug} /> Рубрика</p>
      <h1>{isCatalog ? 'Гид по инструментам' : isCompare ? 'Агрегаторы нейросетей' : rubric.name}</h1>
      <p class="lead">{isCatalog ? 'Для чего инструмент, где он силён и что сверить перед оплатой. Оценок нет.' : isCompare ? 'Сервис, который продаёт доступ к чужим моделям: чат для человека или ключ API. Таблица говорит, для чего каждый. Оценок нет.' : rubric.description}</p>
    </div>
  )}

  {isSpace && (
    <div class="space-gallery container">
      {SPACE_IMAGES.slice(1).map((photo) => (
        <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
      ))}
    </div>
  )}

  <div class="container">
    {isCatalog && (
      <>
        <GuideNotes lang="ru" heading={false} />
        <h2>Карточки из ранних материалов</h2>
        <PartnerDisclosure />
        <SyntxAffiliate />
        <ToolGrid />
      </>
    )}
    {isCompare && <CompareTable lang="ru" />}
    {items.length > 0 ? (
      <div class="cards">{items.map((a, i) => <ArticleCard entry={a} showRubric={false} eager={i === 0 && !isSpace} />)}</div>
    ) : !isCatalog && !isCompare && (
      <div class="empty-state">
        <p>Материалов в этой рубрике пока нет.</p>
      </div>
    )}
  </div>
</BaseLayout>
