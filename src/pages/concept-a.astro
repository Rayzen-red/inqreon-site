---
import ConceptShell from '../layouts/ConceptShell.astro';
import ConceptSwitch from '../components/concepts/ConceptSwitch.astro';
import ConceptFooter from '../components/concepts/ConceptFooter.astro';
import RubricIcon from '../components/concepts/RubricIcon.astro';
import PartnerDisclosure from '../components/PartnerDisclosure.astro';
import { BACKDROPS, TOOLS, loadConceptHome } from '../lib/concept-home';
import '../styles/concept-motion.css';
import '../styles/concept-a.css';

const { articles, rubrics, space, site } = await loadConceptHome();
const slides = articles.map((article, i) => ({ article, backdrop: BACKDROPS[i % BACKDROPS.length] }));
---
<ConceptShell title="Концепт A — космический журнал — Inqreon" description="Черновик главной: тёмный космический журнал Inqreon.">
  <canvas id="stars" aria-hidden="true"></canvas>
  <div class="cosmos">
    <header class="top">
      <a class="logo" href="/"><span class="logo-orb" aria-hidden="true"></span> Inqreon</a>
      <ConceptSwitch current="a" />
      <a class="tg-link" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
    </header>

    <section class="hero" data-slider aria-roledescription="карусель" aria-label="Избранные материалы">
      <div class="hero-frame">
        {slides.map(({ article, backdrop }, i) => (
          <article class:list={['slide', 'hero-slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
            <div class="hero-copy">
              <p class="kicker"><RubricIcon slug={article.rubric} /> {article.rubricName}</p>
              <h1><a href={article.href}>{article.title}</a></h1>
              <p class="dek">{article.description}</p>
              <p class="meta">Проверено {article.dateLabel}</p>
              <a class="btn" href={article.href}>Читать материал</a>
              <figure class="mini-cover">
                <img src={article.cover.src} alt={article.cover.alt} />
                <figcaption>{article.cover.note}</figcaption>
              </figure>
            </div>
            <figure class="hero-photo">
              <img src={backdrop.src} alt={backdrop.alt} />
              <figcaption>{backdrop.note}</figcaption>
            </figure>
          </article>
        ))}
      </div>
      <div class="hero-ui">
        <button type="button" data-prev aria-label="Предыдущий материал">←</button>
        <div class="dots" role="tablist" aria-label="Слайды">
          {slides.map((_, i) => (
            <button type="button" data-dot class:list={[{ 'is-active': i === 0 }]} aria-label={`Слайд ${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'}></button>
          ))}
        </div>
        <button type="button" data-next aria-label="Следующий материал">→</button>
      </div>
    </section>

    <nav class="rubric-nav" aria-label="Рубрики" data-reveal>
      {rubrics.map((r) => (
        <a href={`/${r.slug}/`}>
          <RubricIcon slug={r.slug} />
          <span>{r.name}</span>
        </a>
      ))}
    </nav>

    <section class="wrap" data-reveal>
      <header class="sec-head">
        <h2>Свежие материалы</h2>
        <p>Заголовки и описания — из опубликованных обзоров. Обложки пока абстрактные.</p>
      </header>
      <div class="cards">
        {articles.map((article, i) => (
          <a class="card" href={article.href} style={`--d:${i * 70}ms`} data-reveal>
            <figure>
              <img src={article.cover.src} alt={article.cover.alt} />
              <figcaption>{article.cover.note}</figcaption>
            </figure>
            <p class="tag">{article.rubricName}</p>
            <h3>{article.title}</h3>
            <p>{article.description}</p>
            <p class="meta">Проверено {article.dateLabel}</p>
          </a>
        ))}
      </div>
    </section>

    {space && (
      <section class="space wrap" data-reveal>
        <figure>
          <img src={BACKDROPS[0].src} alt={BACKDROPS[0].alt} />
          <figcaption>{BACKDROPS[0].note}</figcaption>
        </figure>
        <div>
          <p class="kicker"><RubricIcon slug={space.slug} /> {space.name}</p>
          <h2>Рубрика, в которую хочется возвращаться</h2>
          <p>{space.description}</p>
          <a class="btn" href={`/${space.slug}/`}>Открыть рубрику</a>
        </div>
      </section>
    )}

    <section class="wrap tools" data-reveal>
      <header class="sec-head">
        <h2>Инструменты</h2>
        <p>Монограммы вместо логотипов. Карточки ведут в уже вышедшие обзоры.</p>
      </header>
      <PartnerDisclosure />
      <div class="tool-grid">
        {TOOLS.map((tool) => (
          <a class={`tool tone-${tool.tone}`} href={tool.href}>
            <span class="mark" aria-hidden="true">{tool.mark}<small>логотип</small></span>
            <span>
              <strong>{tool.name}</strong>
              <em>{tool.text}</em>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="tg wrap" data-reveal>
      <div>
        <p class="kicker">Канал</p>
        <h2>Короткие разборы — в Telegram</h2>
        <p>Обновления обзоров и даты проверки публикуем в канале Inqreon.</p>
      </div>
      <a class="btn" href={site.telegram} target="_blank" rel="noopener">Открыть t.me/Inqreon</a>
    </section>

    <ConceptFooter />
  </div>
  <script is:inline>
    (() => {
      const canvas = document.getElementById('stars');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const stars = Array.from({ length: 140 }, () => ({
        x: Math.random(),
        y: Math.random(),
        r: Math.random() * 1.3 + 0.25,
        v: Math.random() * 0.00012 + 0.00003,
        a: Math.random() * 0.55 + 0.25,
        tint: Math.random() > 0.82 ? '#67e8f9' : Math.random() > 0.7 ? '#c4b5fd' : '#ffffff',
      }));
      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(innerWidth * dpr);
        canvas.height = Math.floor(innerHeight * dpr);
      };
      const draw = () => {
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        for (const s of stars) {
          if (!reduce) s.y -= s.v;
          if (s.y < 0) s.y = 1;
          ctx.globalAlpha = s.a;
          ctx.fillStyle = s.tint;
          ctx.beginPath();
          ctx.arc(s.x * w, s.y * h, s.r * (window.devicePixelRatio || 1), 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        if (!reduce && !document.hidden) requestAnimationFrame(draw);
      };
      resize();
      draw();
      addEventListener('resize', () => { resize(); if (reduce) draw(); });
    })();
  </script>
</ConceptShell>
