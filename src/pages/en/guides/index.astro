---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { PORTAL_GUIDES } from '../../../data/portal-guides';
import { formatDate } from '../../../data/site';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const byId = new Map(articles.map((entry) => [entry.id, entry]));
const guides = PORTAL_GUIDES.filter((guide) => byId.has(guide.id));
const title = 'Guides — Inqreon';
const description = 'English names for the AI tool guides published in Russian: what each tool is for, with the check date on the original page.';
---
<BaseLayout title={title} description={description}>
  <div class="container page-hero">
    <p class="kicker">Guides</p>
    <h1>Guides</h1>
    <p class="lead">The articles are written in Russian. This page is the same list, with English titles, so the two languages point at the same texts. A regional check of Russia, Uzbekistan, and Kazakhstan stays marked as regional.</p>
  </div>
  <div class="container">
    <ol class="rows">
      {guides.map((guide, index) => {
        const entry = byId.get(guide.id);
        return (
          <li>
            <span class="idx">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3><a href={guide.href} hreflang="ru" lang="ru">{guide.en.title}</a></h3>
              <p>{guide.en.description}</p>
              {entry && <p class="meta">Checked {formatDate(entry.data.checkedAt)}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</BaseLayout>
