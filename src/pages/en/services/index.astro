---
import EnLayout from '../../../layouts/EnLayout.astro';
import EnHeader from '../../../components/en/EnHeader.astro';
import EnFooter from '../../../components/en/EnFooter.astro';
import Hero from '../../../components/en/Hero.astro';
import Rescue from '../../../components/en/Rescue.astro';
import Rest from '../../../components/en/Rest.astro';
import Process from '../../../components/en/Process.astro';
import Pricing from '../../../components/en/Pricing.astro';
import Automations from '../../../components/en/Automations.astro';
import Tail from '../../../components/en/Tail.astro';
import { EMAIL, FIX_TIERS, PAGE } from '../../../data/offer';
import { SERVICE_PATH, automationOffers } from '../../../data/automation';
import { PRICES, SHOW_AUTOMATION_BLOCK } from '../../../data/prices';
import { SITE } from '../../../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Inqreon',
    url: `${SITE.url}${SERVICE_PATH.en}`,
    description: PAGE.description,
    email: EMAIL,
    image: `${SITE.url}/images/en/og-share-1200x630.webp`,
    inLanguage: 'en',
    makesOffer: [
      { '@type': 'Offer', name: 'Scan', price: String(PRICES.scan), priceCurrency: PRICES.currency },
      ...FIX_TIERS.map((tier) => ({
        '@type': 'Offer',
        name: tier.name,
        description: tier.description,
        priceCurrency: PRICES.currency,
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: String(tier.min),
          maxPrice: String(tier.max),
          priceCurrency: PRICES.currency,
        },
      })),
      ...(SHOW_AUTOMATION_BLOCK ? automationOffers('en') : []),
    ],
  },
];
---
<EnLayout path={SERVICE_PATH.en} title="Inqreon — when an AI-built site breaks" description={PAGE.description} schema={schema}>
  <div class="page">
    <EnHeader lang="en" />
    <main id="main">
      <Hero lang="en" />
      <Rescue lang="en" />
      <Rest lang="en" />
      <Process lang="en" />
      <Pricing lang="en" />
      <Automations lang="en" />
      <Tail lang="en" />
    </main>
    <EnFooter lang="en" />
  </div>
</EnLayout>
<script>
  import { initEnPage } from '../../../scripts/en-boot';
  initEnPage();
</script>
