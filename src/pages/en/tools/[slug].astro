---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideArticle from '../../../components/portal/GuideArticle.astro';
import { isPublicGuide } from '../../../lib/guides';

export async function getStaticPaths() {
  const notes = await getCollection('guides', (entry) => entry.data.lang === 'en' && isPublicGuide(entry));
  return notes.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.description} ogImage={entry.data.image} withBrand={false}>
  <GuideArticle entry={entry} />
</BaseLayout>
