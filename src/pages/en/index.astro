---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/portal/Home.astro';
import { SITE } from '../../data/site';

const title = 'Inqreon — AI tools for work and study';
const description = 'Guides to AI tools, a catalog, comparisons of sites that bundle many models, and news. Prices in the guides carry the day they were checked.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: `${SITE.url}/en/`, inLanguage: 'en', description },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url + '/', sameAs: [SITE.telegram, SITE.youtube] },
];
---
<BaseLayout title={title} description={description} withBrand={false} schema={schema}>
  <Home lang="en" />
</BaseLayout>
