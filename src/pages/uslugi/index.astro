---
import EnLayout from '../../layouts/EnLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/en/Hero.astro';
import Rescue from '../../components/en/Rescue.astro';
import Rest from '../../components/en/Rest.astro';
import Process from '../../components/en/Process.astro';
import Pricing from '../../components/en/Pricing.astro';
import Automations from '../../components/en/Automations.astro';
import Tail from '../../components/en/Tail.astro';
import { EMAIL, FIX_TIERS } from '../../data/offer';
import { SERVICE_PATH, automationOffers } from '../../data/automation';
import { PRICES, SHOW_AUTOMATION_BLOCK, formatPrice, formatRange } from '../../data/prices';
import { SITE } from '../../data/site';

const title = 'Inqreon — если сайт, собранный ИИ, сломался';
const description = `Разбор за ${formatPrice(PRICES.scan)}. Починка ${formatRange(PRICES.fix.small.min, PRICES.fix.launch.max)}. Цена фиксируется до начала. Только переписка.`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Inqreon',
    url: `${SITE.url}${SERVICE_PATH.ru}`,
    description,
    email: EMAIL,
    inLanguage: 'ru',
    makesOffer: [
      { '@type': 'Offer', name: 'Разбор', price: String(PRICES.scan), priceCurrency: PRICES.currency },
      ...FIX_TIERS.map((tier) => ({
        '@type': 'Offer',
        name: tier.name,
        priceCurrency: PRICES.currency,
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: String(tier.min),
          maxPrice: String(tier.max),
          priceCurrency: PRICES.currency,
        },
      })),
      ...(SHOW_AUTOMATION_BLOCK ? automationOffers('ru') : []),
    ],
  },
];
---
<EnLayout lang="ru" path={SERVICE_PATH.ru} title={title} description={description} schema={schema}>
  <div class="page">
    <Header />
    <main id="main">
      <Hero lang="ru" />
      <Rescue lang="ru" />
      <Rest lang="ru" />
      <Process lang="ru" />
      <Pricing lang="ru" />
      <Automations lang="ru" />
      <Tail lang="ru" />
    </main>
    <Footer />
  </div>
</EnLayout>
<script>
  import { initEnPage } from '../../scripts/en-boot';
  initEnPage();
</script>
