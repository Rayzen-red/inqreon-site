---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/portal/Home.astro';
import { SITE } from '../data/site';

const title = 'Inqreon — Нейросети для работы и учёбы';
const description = 'Гайды по ИИ-инструментам, каталог, сравнение агрегаторов и новости. Цены в материалах указаны с датой проверки.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url + '/', inLanguage: 'ru', description },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url + '/', sameAs: [SITE.telegram, SITE.youtube] },
];
---
<BaseLayout title={title} description={description} withBrand={false} schema={schema}>
  <Home lang="ru" />
</BaseLayout>
