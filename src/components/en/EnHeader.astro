---
import Support from '../portal/Support.astro';
import { alternatePath } from '../../data/translations.mjs';

interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const paired = alternatePath(path);
const other = paired ?? (lang === 'en' ? '/' : '/en/');
const items = lang === 'en'
  ? [
      { href: '/en/news/', label: 'News' },
      { href: '/en/guides/', label: 'Articles' },
      { href: '/en/tools/', label: 'Guide' },
      { href: '/en/compare/', label: 'Compare' },
      { href: '/en/services/', label: 'Services', current: true },
    ]
  : [
      { href: '/news/', label: 'Новости' },
      { href: '/neyroseti/', label: 'Статьи' },
      { href: '/instrumenty/', label: 'Гид' },
      { href: '/sravneniya/', label: 'Сравнение' },
      { href: '/uslugi/', label: 'Услуги', current: true },
    ];
---
<header class="nav" id="nav">
  <div class="wrap">
    <a class="logo" href={lang === 'ru' ? '/' : '/en/'} aria-label="Inqreon"><span class="logo-mark" aria-hidden="true">iq</span>Inqreon</a>
    <nav class="nav-links" aria-label={lang === 'ru' ? 'Разделы' : 'Sections'}>
      {items.map((item) => (
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="nav-right">
      <div class="lang" role="group" aria-label={lang === 'ru' ? 'Язык' : 'Language'}>
        {lang === 'en' ? <span lang="en" aria-current="true">EN</span> : <a href={other} lang="en" hreflang={paired ? 'en' : undefined}>EN</a>}
        {lang === 'ru' ? <span lang="ru" aria-current="true">RU</span> : <a href={other} lang="ru" hreflang={paired ? 'ru' : undefined}>RU</a>}
      </div>
      <Support />
    </div>
  </div>
  <div class="progress" id="progress"></div>
</header>
