---
import OrderLink from './OrderLink.astro';
import { HAS_UPWORK } from '../../data/offer';

interface Props {
  /** Russian alternate for this page. The landing page pairs with the Russian home. */
  ruHref?: string;
  /** Section links stay on this page. Other English pages point them at the landing page. */
  here?: boolean;
}
const { ruHref = '/', here = true } = Astro.props;
const to = (id: string) => (here ? `#${id}` : `/en/#${id}`);
---
<header class="nav" id="nav">
  <div class="wrap">
    <a class="logo" href="/en/" aria-label="Inqreon"><span class="logo-mark" aria-hidden="true">iq</span>Inqreon</a>
    <nav class="nav-links" aria-label="Main">
      <a href={to('rescue')}>How a rescue works</a>
      <a href={to('pricing')}>Pricing</a>
      <a href={to('case')}>Case</a>
      <a href={to('faq')}>FAQ</a>
    </nav>
    <div class="nav-right">
      <div class="lang" role="group" aria-label="Language">
        <span lang="en" aria-current="true">EN</span>
        <a href={ruHref} lang="ru" hreflang="ru">RU</a>
      </div>
      {HAS_UPWORK ? (
        <OrderLink kind="hire" variant="cta" size="sm" label="Hire on Upwork" />
      ) : (
        <OrderLink kind="scan" variant="cta" size="sm" label="Scan $79" />
      )}
    </div>
  </div>
  <div class="progress" id="progress"></div>
</header>
