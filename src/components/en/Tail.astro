---
import { HAS_UPWORK } from '../../data/offer';
import { PRICES, formatHourly } from '../../data/prices';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const hourly = formatHourly(PRICES.hourly.min, PRICES.hourly.max, ru ? 'ru' : 'en');

const faqs: Array<[string, string]> = ru
  ? [
      ['Какие проекты берёте?', 'Сайты и приложения из Lovable, Bolt, Cursor или v0, обычно с Supabase и Stripe. Если стек другой, начните с разбора: я прямо напишу, могу ли помочь.'],
      ['Почему без звонков?', 'Переписка оставляет каждое решение в письме и не зависит от часового пояса. Когда починка идёт, каждый день приходит короткое письмо.'],
      ['Нужно присылать пароли?', 'Нет. Вы добавляете меня в репозиторий, Supabase и хостинг. Аккаунты и ключи остаются вашими. Доступ можно забрать в любой момент. Пароли и секретные ключи в первое письмо не кладите.'],
      ['Как быстро готов разбор?', 'Письменный отчёт приходит до любой починки. Дату я не обещаю, пока не увижу приложение. После согласия на починку — письмо каждый день.'],
      ['Если починить нельзя?', 'Я пишу это в разборе, до оплаты починки. Не берусь за работу, которую не смогу закончить.'],
      ['Если разбор найдёт больше, чем я ждал?', 'Цена согласована до начала. Если всплывёт новое, я описываю это и называю цену. Без вашего согласия ничего лишнего не делается.'],
      ['Если задача не ложится в ступень?', `Тогда ставка ${hourly}. Я подтверждаю её письмом до начала.`],
      HAS_UPWORK
        ? ['Как платить?', 'На Upwork, фиксированным контрактом. Работа, файлы и оплата остаются на платформе.']
        : ['Как платить?', 'Напишите на почту, чтобы начать разбор. Цену я подтверждаю письмом до начала. Хватит ссылки на проект и короткого описания. Тот же разговор можно вести в Telegram.'],
      ['Кому принадлежит код после починки?', 'Вам. Всё остаётся в вашем репозитории и ваших аккаунтах.'],
    ]
  : [
  [
    'Which projects do you take?',
    'Apps and websites built with Lovable, Bolt, Cursor, or v0, usually with Supabase and Stripe. If yours is different, start with a Scan and I’ll tell you plainly whether I can help.',
  ],
  [
    'Why no calls?',
    'Written messages keep every decision on record, and they work across time zones. Once a fix starts, you get a written update every day.',
  ],
  [
    'Do I have to share passwords?',
    'No. You invite me as a collaborator on the repo, Supabase, and hosting. Accounts and keys stay yours. You can remove my access at any time. Do not send passwords or secret keys in the first email.',
  ],
  [
    'How fast is the Scan?',
    'You get the written report before any repair starts. I do not promise a date until I have seen the app. After you approve a fix, you get a written update every day.',
  ],
  [
    'What if you cannot fix it?',
    'I say so in the Scan, before you pay for a fix. I do not start a repair I cannot finish.',
  ],
  [
    'What if the Scan finds more than I expected?',
    'The price is agreed before work starts. If something new shows up, I describe it and quote it first. Nothing extra happens without your OK.',
  ],
  [
    'What if the job doesn’t fit a tier?',
    `Then it’s ${hourly}. I confirm the rate in writing before I start.`,
  ],
  HAS_UPWORK
    ? [
        'How do I pay?',
        'On Upwork, by a fixed-price contract. Work, files, and payment stay on the platform.',
      ]
    : [
        'How do I pay?',
        'Email me to start the Scan. I confirm the price in writing before I start. A project link and a short description are enough. Telegram works for the same conversation.',
      ],
  [
    'Who owns the code after the fix?',
    'You do. Everything stays in your repository and your accounts.',
  ],
];
---
<section class="sec" style="padding-top:0" aria-labelledby="rules-h">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">{ru ? 'Как я работаю' : 'How I work'}</span>
      <h2 id="rules-h">{ru ? 'Пять правил, которые не нарушаю' : "Five rules I don't break"}</h2>
    </div>
    <div class="rules">
      <div class="rule rv"><span class="ix">01</span><b>{ru ? 'Только переписка' : 'Written messages only'}</b><p>{ru ? 'Без звонков. Каждое решение остаётся в письме.' : 'No calls. Every decision stays on record.'}</p></div>
      <div class="rule rv"><span class="ix">02</span><b>{ru ? 'Фиксированная цена' : 'Fixed price'}</b><p>{ru ? 'Согласована до начала. Почасовая ставка — только если ступень не подходит.' : 'Agreed before work starts. Hourly only when a tier doesn’t fit.'}</p></div>
      <div class="rule rv"><span class="ix">03</span><b>{ru ? 'Письмо каждый день' : 'Daily updates'}</b><p>{ru ? 'В каждый день починки понятно, что сделано.' : 'Every day of a fix, you know what was done.'}</p></div>
      <div class="rule rv"><span class="ix">04</span><b>{ru ? 'Ключи остаются у вас' : 'Your keys stay yours'}</b><p>{ru ? 'Вы приглашаете меня и можете забрать доступ когда угодно.' : 'You invite me. You can remove access at any time.'}</p></div>
      {HAS_UPWORK ? (
        <div class="rule rv"><span class="ix">05</span><b>{ru ? 'Всё на Upwork' : 'Stays on Upwork'}</b><p>{ru ? 'Работа и оплата остаются на платформе.' : 'Work and payment stay on the platform.'}</p></div>
      ) : (
        <div class="rule rv"><span class="ix">05</span><b>{ru ? 'Сначала ваше согласие' : 'You approve first'}</b><p>{ru ? 'Чтобы начать, хватает ссылки и описания поломки. Код не меняется, пока вы не согласны с планом.' : 'A link and what is broken are enough to start. No code changes until you approve the plan.'}</p></div>
      )}
    </div>
  </div>
</section>

<section class="sec" id="case" style="padding-top:0" aria-labelledby="case-h">
  <div class="wrap case">
    <div class="rv">
      <span class="eyebrow">{ru ? 'Свой проект, не клиент' : 'Case · my own project'}</span>
      <h2 id="case-h" style="margin-top:16px">inqreon.com</h2>
      <p class="lead" style="margin-top:16px">{ru ? 'Этот сайт и телеграм-бот. Собрал в Cursor, довёл домен, выкладку и мобильную вёрстку. Сайт и бот работают.' : 'This site and a Telegram bot. I built it in Cursor and took it through the domain, deploy, and a mobile layout. The site and the bot are live.'}</p>
      <dl>
        <dt>{ru ? 'Роль' : 'Role'}</dt><dd>{ru ? 'Разработка и дизайн' : 'Developer and designer'}</dd>
        <dt>{ru ? 'Стек' : 'Stack'}</dt><dd>Astro · GitHub Actions · GitHub Pages</dd>
        <dt>{ru ? 'Сделано' : 'Done'}</dt><dd>{ru ? 'Домен, автоматическая выкладка, мобильная вёрстка, бот с автопостингом' : 'Domain, automatic deploy, mobile layout, Telegram bot with auto-posting'}</dd>
        <dt>{ru ? 'Статус' : 'Status'}</dt><dd>{ru ? 'Сайт и бот работают' : 'Site and bot are live'}</dd>
      </dl>
      <p class="price-note">{ru ? 'Это мой проект, не клиентский.' : 'This is my own project, not a client.'}</p>
    </div>
    <div class="pipe rv" id="pipe" role="img" aria-label="Deploy pipeline: Cursor, GitHub, Actions, Pages, inqreon.com. A Telegram bot auto-posts to the channel.">
      <div class="pipe-row">
        <span class="node">Cursor</span><span class="edge"></span>
        <span class="node">GitHub</span><span class="edge"></span>
        <span class="node">Actions</span><span class="edge"></span>
        <span class="node">Pages</span><span class="edge"></span>
        <span class="node end">inqreon.com ✓</span>
      </div>
      <div class="branch">
        <span class="node">Telegram bot</span><span class="edge"></span>
        <span class="node">auto-posting</span><span class="edge"></span>
        <span class="node end">channel ✓</span>
      </div>
      <p class="pipe-cap">Push to main → build → deploy. No manual uploads.</p>
    </div>
  </div>
</section>

<section class="sec" id="faq" style="padding-top:0" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-h">{ru ? 'Вопросы' : 'Questions'}</h2>
    </div>
    <div class="faq">
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
    <p class="price-note">{ru ? 'Написать можно кнопкой «Написать в поддержку» в шапке: бот или почта.' : 'The support button in the header opens the bot or email.'}</p>
  </div>
</section>
