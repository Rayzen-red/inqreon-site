---
import { EMAIL, TELEGRAM_URL } from '../../data/offer';

interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const ru = lang === 'ru';
---
<footer>
  <div class="wrap">
    <span>© {year} Inqreon</span>
    <span>{ru ? 'Гайды по инструментам и одна страница про починку сайтов' : 'AI tool guides, and one page for a broken AI-built site'}</span>
    <span class="foot-links">
      <a href={ru ? '/' : '/en/'}>{ru ? 'Главная' : 'Home'}</a>
      <a href={ru ? '/news/' : '/en/news/'}>{ru ? 'Новости' : 'News'}</a>
      <a href={ru ? '/instrumenty/' : '/en/tools/'}>{ru ? 'Гид' : 'Guide'}</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">Telegram</a>
      <a href={ru ? '/politika-konfidencialnosti/' : '/en/privacy/'}>{ru ? 'Конфиденциальность' : 'Privacy'}</a>
    </span>
  </div>
</footer>
