---
import { EMAIL, HAS_UPWORK, TELEGRAM_URL, UPWORK_URL, SCAN_MAIL } from '../../data/offer';
interface Props {
  /** News pages use a plain mailto so the prefilled order text stays on /en/. */
  plainMail?: boolean;
}
const { plainMail = false } = Astro.props;
const year = new Date().getFullYear();
const mailHref = HAS_UPWORK ? UPWORK_URL : plainMail ? `mailto:${EMAIL}` : SCAN_MAIL;
---
<footer>
  <div class="wrap">
    <span>© {year} Inqreon</span>
    <span>I fix AI-built websites and apps</span>
    <span class="foot-links">
      <a href="/en/news/">News</a>
      <a href={mailHref}>{HAS_UPWORK ? 'Upwork' : EMAIL}</a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">Telegram</a>
    </span>
  </div>
</footer>
