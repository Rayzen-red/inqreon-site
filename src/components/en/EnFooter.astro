---
import { EMAIL, HAS_UPWORK, TELEGRAM_URL, UPWORK_URL, SCAN_MAIL } from '../../data/offer';

interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <span>© {year} Inqreon</span>
    <span>{lang === 'ru' ? 'Программы и автоматизации под ваш запрос' : 'I fix AI-built websites and apps'}</span>
    <a href="/">{lang === 'ru' ? 'Журнал' : 'Journal'}</a>
    <span class="foot-links">
      <a href={HAS_UPWORK ? UPWORK_URL : SCAN_MAIL}>{HAS_UPWORK ? 'Upwork' : EMAIL}</a>
      <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">Telegram</a>
    </span>
  </div>
</footer>
