---
import { PRICES, formatHourly, formatPrice, formatRange } from '../../data/prices';

interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">{ru ? 'Lovable, Bolt, Cursor и v0' : 'For Lovable, Bolt, Cursor, and v0'}</span>
      <h1>
        {ru ? (
          <><span class="ln">Сайт, собранный ИИ,</span><span class="ln">ломается после запуска</span></>
        ) : (
          <><span class="ln">An AI-built site</span><span class="ln">breaks after launch</span></>
        )}
      </h1>
      <p class="lead">
        {ru
          ? 'В превью он открывается. У живого человека сыпятся вход, доступ к данным, оплата или деплой. Ниже — как устроен разбор и починка. Цена фиксируется письмом до любых правок. Звонков нет.'
          : 'It opens in preview. A real person then hits login, data access, payments, or deploy. Below is how a look and a fix are done. The price is fixed in writing before anything changes. No calls.'}
      </p>
      <p class="hero-prices">
        <b>{formatPrice(PRICES.scan)}</b> {ru ? 'разбор' : 'Scan'}
        <span aria-hidden="true">·</span>
        <b>{formatRange(PRICES.fix.small.min, PRICES.fix.launch.max)}</b> {ru ? 'починка' : 'Fix'}
        <span aria-hidden="true">·</span>
        <b>{formatHourly(PRICES.hourly.min, PRICES.hourly.max, ru ? 'ru' : 'en')}</b>
      </p>
      <p class="hero-quiet"><a href="#pricing">{ru ? 'Цены и как написать' : 'Prices, and how to write'}</a></p>
      <div class="hero-meta">
        <span>{ru ? 'Цена до начала работы' : 'Price before work starts'}</span>
        <span>{ru ? 'Только переписка' : 'Written messages, no calls'}</span>
        <span>{ru ? 'Ключи остаются у вас' : 'Your accounts and keys stay yours'}</span>
      </div>
    </div>
    <div class="term" id="term" role="img" aria-label={ru ? 'Пример терминала: приложение проверяют и чинят' : 'Illustrative terminal: an AI-built app is checked and fixed'}>
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term-title">your-app → production</span>
        <span class="status bad" id="termStatus">BROKEN</span>
      </div>
      <div class="term-body" id="termBody"></div>
      <div class="term-foot">
        <span>{ru ? 'Пример, не клиент' : 'Illustrative example'}</span>
        <button class="replay" id="replay" type="button">{ru ? '↻ Ещё раз' : '↻ Replay'}</button>
      </div>
    </div>
  </div>
</section>
<div class="tools">
  <div class="wrap">
    <span class="lbl">{ru ? 'Обычно собрано в' : 'Projects built with'}</span>
    <ul>
      <li>Lovable</li><li>Bolt</li><li>Cursor</li><li>v0</li><li>Supabase</li><li>Stripe</li>
    </ul>
  </div>
</div>
