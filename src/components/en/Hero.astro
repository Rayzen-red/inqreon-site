---
import OrderLink from './OrderLink.astro';
import { HAS_UPWORK, TELEGRAM_URL } from '../../data/offer';
import { PRICES, formatPrice } from '../../data/prices';
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">For Lovable, Bolt, Cursor, and v0</span>
      <h1><span class="ln">I fix AI-built</span><span class="ln">websites and apps</span></h1>
      <p class="lead">It works in preview and breaks for real users. I make login, security, payments, and deploy hold up in production. Written messages only. The price is fixed before I start.</p>
      <p class="hero-prices"><b>{formatPrice(PRICES.scan)}</b> Scan <span aria-hidden="true">·</span> <b>from {formatPrice(PRICES.fix.low)}</b> Fix <span aria-hidden="true">·</span> <b>{formatPrice(PRICES.support)}/mo</b> Support</p>
      <div class="hero-ctas">
        <OrderLink kind="scan" variant="cta" label={HAS_UPWORK ? 'Hire me on Upwork' : `Order a Scan — ${formatPrice(PRICES.scan)}`} />
        <a class="btn" href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">Telegram <span class="arr" aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-meta">
        <span>Fixed price before work starts</span>
        <span>Written messages, no calls</span>
        <span>Your accounts and keys stay yours</span>
      </div>
    </div>
    <div class="term" id="term" role="img" aria-label="Illustrative terminal: an AI-built app is checked and fixed">
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term-title">your-app → production</span>
        <span class="status bad" id="termStatus">BROKEN</span>
      </div>
      <div class="term-body" id="termBody"></div>
      <div class="term-foot">
        <span>Illustrative example</span>
        <button class="replay" id="replay" type="button">↻ Replay</button>
      </div>
    </div>
  </div>
</section>
<div class="tools">
  <div class="wrap">
    <span class="lbl">Projects built with</span>
    <ul>
      <li>Lovable</li><li>Bolt</li><li>Cursor</li><li>v0</li><li>Supabase</li><li>Stripe</li>
    </ul>
  </div>
</div>
