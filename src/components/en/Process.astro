---
import Picture from './Picture.astro';
import { FIX_TIERS } from '../../data/offer';
import { PRICES, formatPrice } from '../../data/prices';
const steps: Array<{
  n: string;
  name: string;
  title: string;
  price?: string;
  alt: string;
  text: string;
}> = [
  {
    n: '01',
    name: 'bot-scan',
    title: 'Scan',
    price: formatPrice(PRICES.scan),
    alt: 'Scan agent: a small glass robot with a lime scanning beam across its eyes.',
    text: 'You give me read-only access. I send a written report: what is broken, who owns each account, and a fixed price. Nothing changes until you approve it.',
  },
  {
    n: '02',
    name: 'bot-fix',
    title: 'Fix',
    price: FIX_TIERS.map((tier) => tier.price).join(' / '),
    alt: 'Fix agent: the same glass robot, with stylus tools and lime sparks.',
    text: 'You approve the plan and the price. I repair the app and send a written update every day.',
  },
  {
    n: '03',
    name: 'bot-launch',
    title: 'Launch',
    alt: 'Launch agent: the same glass robot, brighter, with a mint glow.',
    text: 'The app goes live on your domain. You get a short handover note.',
  },
];
---
<section class="sec" id="process" aria-labelledby="proc-h">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Process</span>
      <h2 id="proc-h">Three steps. No surprises.</h2>
    </div>
    <div class="proc">
      {steps.map((step) => (
        <div class="ps rv">
          <Picture
            class="mascot"
            name={step.name}
            widths={[800, 1024]}
            width={1024}
            height={1024}
            alt={step.alt}
            sizes="132px"
          />
          <div class="num">{step.n}</div>
          <h3>{step.title}</h3>
          {step.price ? <div class="price">{step.price}</div> : null}
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
