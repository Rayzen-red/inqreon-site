---
import Picture from './Picture.astro';
import { FIX_TIERS } from '../../data/offer';
import { PRICES, formatPrice } from '../../data/prices';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const steps: Array<{
  n: string;
  name: string;
  title: string;
  price?: string;
  alt: string;
  text: string;
}> = [
  {
    n: '01',
    name: 'bot-scan',
    title: ru ? 'Разбор' : 'Scan',
    price: formatPrice(PRICES.scan),
    alt: ru ? 'Маленький стеклянный робот с зелёным лучом.' : 'Scan agent: a small glass robot with a lime scanning beam across its eyes.',
    text: ru ? 'Вы даёте доступ только на чтение. Я присылаю письмо: что сломано, кто владеет каждым аккаунтом и фиксированная цена. До вашего согласия ничего не меняется.' : 'You give me read-only access. I send a written report: what is broken, who owns each account, and a fixed price. Nothing changes until you approve it.',
  },
  {
    n: '02',
    name: 'bot-fix',
    title: ru ? 'Починка' : 'Fix',
    price: FIX_TIERS.map((tier) => tier.price).join(' / '),
    alt: ru ? 'Тот же робот, с инструментами.' : 'Fix agent: the same glass robot, with stylus tools and lime sparks.',
    text: ru ? 'Вы соглашаете план и цену. Я чиню и каждый день пишу, что сделано.' : 'You approve the plan and the price. I repair the app and send a written update every day.',
  },
  {
    n: '03',
    name: 'bot-launch',
    title: ru ? 'Запуск' : 'Launch',
    alt: ru ? 'Тот же робот, уже светлее.' : 'Launch agent: the same glass robot, brighter, with a mint glow.',
    text: ru ? 'Приложение открывается на вашем домене. Вы получаете короткую записку, что куда положено.' : 'The app goes live on your domain. You get a short handover note.',
  },
];
---
<section class="sec" id="process" aria-labelledby="proc-h">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">{ru ? 'Как идёт работа' : 'Process'}</span>
      <h2 id="proc-h">{ru ? 'Три шага. Цена известна заранее.' : 'Three steps. No surprises.'}</h2>
    </div>
    <div class="proc">
      {steps.map((step) => (
        <div class="ps rv">
          <Picture
            class="mascot"
            name={step.name}
            widths={[800, 1024]}
            width={1024}
            height={1024}
            alt={step.alt}
            sizes="132px"
          />
          <div class="num">{step.n}</div>
          <h3>{step.title}</h3>
          {step.price ? <div class="price">{step.price}</div> : null}
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
