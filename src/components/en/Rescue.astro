---
import Picture from './Picture.astro';

const frames = [
  { name: 'layers-broken', label: 'Broken', alt: 'Illustration of a glass app split into five layers, with a red glitch. Not a client project.' },
  { name: 'layers-scanning', label: 'Scan', alt: 'The same glass layers, with a lime scanning light and a small robot. Not a client project.' },
  { name: 'layers-fixing', label: 'Fix', alt: 'Robots repairing the glass layers. The upper plates glow lime, the lower ones still show red. Not a client project.' },
  { name: 'layers-reassembled', label: 'Launch', alt: 'The glass app assembled again, with a lime glow. Not a client project.' },
];
---
<section class="rescue" id="rescue" aria-labelledby="rescue-h">
  <div class="wrap rescue-intro sec-head">
    <span class="eyebrow">Scroll to watch a rescue</span>
    <h2 id="rescue-h">Broken → Scan → Fix → Launch</h2>
    <p class="lead">An AI-built app is a stack of layers. When one is wrong, the whole thing fails for real users. I take it apart, fix each layer and put it back together.</p>
  </div>
  <div class="pin wrap" id="pin">
    <ol class="steps" id="steps">
      <li class="step on"><b>Broken</b><span>Looks fine in preview. Real users hit login loops, open data and failed payments.</span></li>
      <li class="step"><b>Scan</b><span>I go layer by layer and write down what is broken, in plain English.</span></li>
      <li class="step"><b>Fix</b><span>Each layer gets repaired by a fixed plan you approved.</span></li>
      <li class="step"><b>Launch</b><span>Everything goes back together and goes live on your domain.</span></li>
    </ol>
    <div>
      <div class="scene" id="scene">
        <canvas id="rescue-canvas" aria-hidden="true"></canvas>
        <Picture
          class="scene-poster"
          name="layers-broken"
          widths={[800, 1600]}
          width={1600}
          height={900}
          alt=""
          sizes="(max-width: 860px) 92vw, 640px"
        />
        <div class="scene-story" id="scene-story">
          {frames.map((frame) => (
            <figure class="story-card">
              <Picture
                name={frame.name}
                widths={[800, 1600]}
                width={1600}
                height={900}
                alt={frame.alt}
                sizes="(max-width: 860px) 92vw, 640px"
              />
              <figcaption>{frame.label}</figcaption>
            </figure>
          ))}
        </div>
        <p class="live" id="live"><span class="status good">LIVE</span><span>Ready for real users</span></p>
        <p class="scene-cap">Illustration · not a real client project</p>
      </div>
      <p class="mcap" id="mcap" aria-hidden="true"></p>
    </div>
  </div>
</section>
