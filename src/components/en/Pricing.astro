---
import OrderLink from './OrderLink.astro';
import { FIX_TIERS, HAS_UPWORK, TELEGRAM_URL } from '../../data/offer';
import { PRICES, formatPrice } from '../../data/prices';
---
<section class="sec" id="pricing" aria-labelledby="price-h">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Pricing</span>
      <h2 id="price-h">Fixed prices. Agreed before I start.</h2>
    </div>
    <div class="prices">
      <article class="pc rv">
        <span class="tag">Start here</span>
        <h3>Scan</h3>
        <div class="amt">{formatPrice(PRICES.scan)}</div>
        <p class="tier-desc">A written report before any code changes: what is broken, who owns each account, and a fixed price for the repair.</p>
        <ul>
          <li>What is broken, in plain English</li>
          <li>Who owns each account and key</li>
          <li>A fixed price for the repair</li>
          <li>Nothing changes until you approve it</li>
        </ul>
        <OrderLink kind="scan" label="Order a Scan" />
      </article>
      <article class="pc feat rv">
        <span class="tag">Repair and launch</span>
        <h3>Fix</h3>
        <div class="amt" id="fixAmt">{FIX_TIERS[0].price}</div>
        <fieldset class="tiers">
          <legend>Scope</legend>
          {FIX_TIERS.map((tier, i) => (
            <>
              <input type="radio" name="tier" id={tier.id} value={String(i)} checked={i === 0} data-price={tier.price} data-desc={tier.description} />
              <label for={tier.id}>{tier.price}</label>
            </>
          ))}
        </fieldset>
        <p class="tier-desc" id="tierDesc" aria-live="polite">{FIX_TIERS[0].description}</p>
        <ul>
          <li>Login, Supabase security, Stripe, deploy</li>
          <li>A written update every day</li>
          <li>The tier is set after the Scan, before work starts</li>
        </ul>
        <OrderLink kind="fix" variant="cta" label="Get my app fixed" />
      </article>
      <article class="pc rv">
        <span class="tag">After launch</span>
        <h3>Support</h3>
        <div class="amt">{formatPrice(PRICES.support)}<small>/ month</small></div>
        <ul>
          <li>Backups</li>
          <li>Uptime checks</li>
          <li>A monthly note on what changed</li>
        </ul>
        <OrderLink kind="support" label="Add Support" />
      </article>
    </div>
    {HAS_UPWORK ? (
      <p class="price-note">Work and payment stay on Upwork.</p>
    ) : (
      <p class="price-note">Email to start. The price is agreed in writing before I change anything. <a href={TELEGRAM_URL} target="_blank" rel="noopener noreferrer">Telegram</a> works too.</p>
    )}
  </div>
</section>
