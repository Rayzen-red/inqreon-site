---
import Support from './portal/Support.astro';
import { alternatePath } from '../data/translations.mjs';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const lang = path === '/en' || path.startsWith('/en/') ? 'en' : 'ru';
const pairedHref = alternatePath(path);
let href = pairedHref;
if (!href && lang === 'ru' && path.startsWith('/neyroseti/')) href = '/en/guides/';
if (!href && lang === 'en' && path.startsWith('/en/guides')) href = '/neyroseti/';
if (!href) href = lang === 'en' ? '/' : '/en/';
const paired = Boolean(pairedHref);

const items = lang === 'en'
  ? [
      { href: '/en/news/', label: 'News', match: (p: string) => p.startsWith('/en/news') },
      { href: '/en/guides/', label: 'Articles', match: (p: string) => p.startsWith('/en/guides') },
      { href: '/en/tools/', label: 'Guide', match: (p: string) => p.startsWith('/en/tools') },
      { href: '/en/compare/', label: 'Compare', match: (p: string) => p.startsWith('/en/compare') },
      { href: '/en/services/', label: 'Services', match: (p: string) => p.startsWith('/en/services') },
    ]
  : [
      { href: '/news/', label: 'Новости', match: (p: string) => p.startsWith('/news') },
      { href: '/neyroseti/', label: 'Статьи', match: (p: string) => p.startsWith('/neyroseti') },
      { href: '/instrumenty/', label: 'Гид', match: (p: string) => p.startsWith('/instrumenty') },
      { href: '/sravneniya/', label: 'Сравнение', match: (p: string) => p.startsWith('/sravneniya') },
      { href: '/uslugi/', label: 'Услуги', match: (p: string) => p.startsWith('/uslugi') },
    ];
---
<header class="site-header">
  <div class="topbar">
    <a href={lang === 'en' ? '/en/' : '/'} class="logo" aria-label="Inqreon">
      <span class="logo-mark" aria-hidden="true">iq</span> Inqreon
    </a>
    <nav class="site-nav" aria-label={lang === 'en' ? 'Sections' : 'Разделы'}>
      {items.map((item) => (
        <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="head-tools">
      <nav class="lang-switch" aria-label={lang === 'en' ? 'Language' : 'Язык'}>
        {lang === 'en' ? (
          <span lang="en" aria-current="true">EN</span>
        ) : (
          <a href={href} hreflang={paired ? 'en' : undefined} lang="en">EN</a>
        )}
        {lang === 'ru' ? (
          <span lang="ru" aria-current="true">RU</span>
        ) : (
          <a href={href} hreflang={paired ? 'ru' : undefined} lang="ru">RU</a>
        )}
      </nav>
      <Support />
    </div>
  </div>
</header>
