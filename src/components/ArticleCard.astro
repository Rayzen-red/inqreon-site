---
import { getRubric } from '../data/rubrics';
import { formatDate } from '../data/site';
import { coverFor } from '../lib/media';

interface Props {
  entry: { id: string; data: { rubric: string; title: string; description: string; updatedAt?: Date; checkedAt: Date } };
  showRubric?: boolean;
  eager?: boolean;
}
const { entry, showRubric = true, eager = false } = Astro.props;
const d = entry.data;
const href = `/${d.rubric}/${entry.id}/`;
const cover = coverFor(entry.id);
---
<a class="card" href={href} data-reveal>
  <figure>
    <img
      src={cover.src}
      alt={cover.alt}
      width={cover.width}
      height={cover.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </figure>
  {showRubric && <p class="tag">{getRubric(d.rubric).name}</p>}
  <h3>{d.title}</h3>
  <p>{d.description}</p>
  <p class="meta">Проверено {formatDate(d.updatedAt ?? d.checkedAt)}</p>
</a>
