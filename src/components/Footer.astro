---
import { SITE } from '../data/site';
import { RUBRICS } from '../data/rubrics';
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="foot-grid">
    <div>
      <p class="foot-brand">Inqreon</p>
      <p>{SITE.tagline}. Проверяем доступность по странам и указываем дату проверки цен.</p>
      <p><a href={SITE.telegram} target="_blank" rel="noopener">t.me/Inqreon</a></p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div>
      <p class="foot-title">Рубрики</p>
      <ul>
        {RUBRICS.map((r) => <li><a href={`/${r.slug}/`}>{r.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="foot-title">О сайте</p>
      <ul>
        <li><a href="/o-proekte/">О проекте</a></li>
        <li><a href="/redakcionnaya-politika/">Как мы проверяем информацию</a></li>
        <li><a href="/raskrytie-partnerskih-ssylok/">Раскрытие партнёрских ссылок</a></li>
        <li><a href="/politika-konfidencialnosti/">Политика конфиденциальности</a></li>
        <li><a href="/kontakty/">Контакты</a></li>
      </ul>
    </div>
  </div>
  <p class="foot-legal">© {year} Inqreon — проект {SITE.owner} ({SITE.ownerCountry}). Материалы носят справочный характер и не являются юридической или финансовой консультацией. Цены и условия сервисов меняются — перед оплатой сверяйтесь с официальным сайтом.</p>
</footer>
