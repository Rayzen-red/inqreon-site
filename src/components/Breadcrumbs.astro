---
interface Crumb { name: string; href?: string }
const { items, label = 'Хлебные крошки' } = Astro.props as { items: Crumb[]; label?: string };
---
<nav class="breadcrumbs" aria-label={label}>
  <ol>
    {items.map((c, i) => (
      <li>
        {c.href && i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
