---
import { partnerOutbound } from '../data/partners';
// Рекламный блок SYNTX. Адрес берётся из src/data/partners.ts. erid пока нет.
const link = partnerOutbound('syntx');
const href = link?.href ?? '';
---
{link?.sponsored && (
<aside class="ad-card" data-partner="SYNTX">
  <Fragment set:html="<!-- erid: ЗАПОЛНИТЬ (erid ещё не получен) -->" />
  <span class="ad-label">Реклама</span>
  <p class="ad-title">
    <a class="ad-link" href={href} rel="sponsored nofollow noopener" target="_blank">Доступ к нейросетям в Telegram — SYNTX</a>
  </p>
  <span class="ad-caption">Рекламодатель: SYNTX INTELLIGENCE – FZCO (ОАЭ), рег. № 70517</span>
</aside>
)}
